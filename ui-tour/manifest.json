{
  "name": "UIの見本",
  "description": "拡張機能が出せる画面（ツールチップ・バッジ・右クリックのメニュー・サイドパネル・通知・ショートカット）の見本",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["contextMenus", "sidePanel", "notifications"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "UIの見本（ツールチップ）",
    "default_icon": "icon.png"
  },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "サイドパネルを開く"
    }
  },
  "icons": { "128": "icon.png" }
}
